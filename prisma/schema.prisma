generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TestimonialType {
  TEXT
  IMAGE
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Profile {
  id                String        @id @default(cuid())
  slug              String        @unique
  displayName       String
  username          String
  role              String
  headline          String
  bio               String
  location          String?
  email             String
  phone             String?
  avatarPublicId    String?
  avatarUrl         String?
  cvPublicId        String?
  cvUrl             String?
  accentColor       String        @default("#ff0055")
  socials           Json
  skills            Json
  stats             Json
  heroText          Json
  aboutText         Json
  contactText       Json
  footerText        Json
  navLabels         Json
  sectionTitles     Json
  sectionVisibility Json
  projects          Project[]
  testimonials      Testimonial[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([slug])
}

model Project {
  id              String         @id @default(cuid())
  profileId       String
  profile         Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title           String
  slug            String
  category        String
  year            Int
  description     String
  longDescription String
  role            String
  tools           String[]
  liveUrl         String?
  caseStudyUrl    String?
  order           Int            @default(0)
  featured        Boolean        @default(false)
  placeholder     Boolean        @default(true)
  images          ProjectImage[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([profileId, slug])
  @@index([profileId, order])
  @@index([profileId, featured])
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  publicId  String
  alt       String
  order     Int      @default(0)
  isCover   Boolean  @default(false)

  @@index([projectId, order])
}

model Testimonial {
  id            String          @id @default(cuid())
  profileId     String
  profile       Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type          TestimonialType
  authorName    String
  authorRole    String
  content       String?
  imageUrl      String?
  imagePublicId String?
  order         Int             @default(0)
  showOnHome    Boolean         @default(true)
  createdAt     DateTime        @default(now())

  @@index([profileId, order])
  @@index([profileId, showOnHome])
}
